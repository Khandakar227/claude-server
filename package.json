{
  "name": "claude-server",
  "version": "0.1.0",
  "private": true,
  "description": "Personal HTTP/WebSocket server that exposes the local Claude Code (Agent SDK) with real-time streaming, resumable sessions, and concurrency control.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/claude-server.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "build": "npm run typecheck && npm run build:bundle && npm run build:exe",
    "gen-token": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^5.16.1",
    "esbuild": "^0.28.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
