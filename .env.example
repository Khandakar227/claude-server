# Copy to .env and fill in. Generate a token with: npm run gen-token
# --- HTTP/WS server ---
HOST=127.0.0.1
PORT=8787
AUTH_TOKEN=

# --- Agent defaults (overridable per request) ---
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_PERMISSION_MODE=bypassPermissions
DEFAULT_MAX_TURNS=30

# --- Concurrency & limits ---
MAX_CONCURRENT_RUNS=4
MAX_QUEUE=50
RUN_TIMEOUT_MS=600000

# --- Workspaces ---
# Per-session working directory root. Each session gets ./<root>/<session_id>.
# Relative paths resolve next to the executable. Use an ABSOLUTE path if you
# want sessions to resume consistently no matter where you launch from.
WORKSPACE_ROOT=./workspaces

# --- Sessions ---
# true (default): conversations are saved to ~/.claude/projects and resumable.
# false: ALL chats are ephemeral (no transcript on disk, not resumable) unless a
# request overrides with "persist": true.
PERSIST_SESSIONS=true

# --- Logging ---
LOG_LEVEL=info
# Set to 1 for human-readable logs in dev (requires pino-pretty)
LOG_PRETTY=0

# IMPORTANT: do NOT set ANTHROPIC_API_KEY here.
# Leaving it unset makes the SDK use your Claude Code subscription login
# (~/.claude/.credentials.json). Setting it switches to metered API billing.
